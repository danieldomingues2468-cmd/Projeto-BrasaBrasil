<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>



<AnchorPane
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.senai.javafx.brasabrasil.CardapioController"
        stylesheets="@style.css"
        prefWidth="1920.0"
        prefHeight="1080.0"
        style="-fx-background-color: #111111;">


    <!-- Cabeçalho principal -->
    <fx:include source="Cabecalho.fxml"
                AnchorPane.topAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"/>



    <!-- Barra lateral de categorias -->
    <VBox spacing="16"
          prefWidth="255"
          AnchorPane.topAnchor="90.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          style="-fx-background-color: #090909; -fx-padding: 30 18 25 18;">

        <Label text="EXPLORE"
               style="-fx-text-fill: #999999; -fx-font-size: 13px; -fx-font-weight: bold;"/>

        <Label text="Nosso cardápio"
               wrapText="true"
               style="-fx-text-fill: white; -fx-font-size: 25px; -fx-font-weight: bold;"/>

        <Region prefHeight="8"/>


        <Button fx:id="btnHamburgueres"
                text="🍔  Hambúrgueres"
                onAction="#mostrarHamburgueres"
                maxWidth="Infinity"
                styleClass="item-cardapio"/>

        <Button fx:id="btnBebidas"
                text="🥤  Bebidas"
                onAction="#mostrarBebidas"
                maxWidth="Infinity"
                styleClass="item-cardapio"/>

        <Button fx:id="btnSobremesas"
                text="🍰  Sobremesas"
                onAction="#mostrarSobremesas"
                maxWidth="Infinity"
                styleClass="item-cardapio"/>

        <Button fx:id="btnPromocoes"
                text="🔥  Promoções"
                onAction="#mostrarPromocoes"
                maxWidth="Infinity"
                styleClass="item-cardapio"/>


        <Region VBox.vgrow="ALWAYS"/>

        <Label text="BRASA BRASIL"
               style="-fx-text-fill: #FFD84A; -fx-font-size: 17px; -fx-font-weight: bold;"/>

        <Label text="Sabor que marca."
               style="-fx-text-fill: #777777; -fx-font-size: 13px;"/>

    </VBox>

    <!-- Área central -->
    <VBox spacing="20"
          AnchorPane.topAnchor="115.0"
          AnchorPane.leftAnchor="285.0"
          AnchorPane.rightAnchor="385.0"
          AnchorPane.bottomAnchor="25.0">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="FEITO NA BRASA"
                       style="-fx-text-fill: #FFD84A; -fx-font-size: 12px; -fx-font-weight: bold;"/>

                <Label fx:id="tituloCategoria"
                       text="HAMBÚRGUERES"
                       style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;"/>

                <Label text="Escolha seus favoritos e monte seu pedido."
                       style="-fx-text-fill: #999999; -fx-font-size: 14px;"/>
            </VBox>
        </HBox>

        <Separator style="-fx-background-color: #292929;"/>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: #111111; -fx-background-color: #111111;"
                    VBox.vgrow="ALWAYS">

            <content>
                <FlowPane fx:id="listaProdutos"
                          hgap="18"
                          vgap="18"
                          prefWrapLength="1100"
                          style="-fx-background-color: #111111; -fx-padding: 5 5 20 5;"/>
            </content>

        </ScrollPane>
    </VBox>

    <!-- Painel do pedido -->
    <VBox spacing="15"
          prefWidth="345"

          AnchorPane.topAnchor="110.0"
          AnchorPane.rightAnchor="20.0"
          AnchorPane.bottomAnchor="25.0"
          style="-fx-background-color: #090909; -fx-background-radius: 18; -fx-padding: 22;">

        <Label text="SEU PEDIDO"
               style="-fx-text-fill: white; -fx-font-size: 23px; -fx-font-weight: bold;"/>

        <Label text="Confira os itens selecionados"
               style="-fx-text-fill: #888888; -fx-font-size: 12px;"/>

        <ListView fx:id="listaPedido"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #191919; -fx-control-inner-background: #191919; -fx-background-radius: 10; -fx-border-color: #292929; -fx-border-radius: 10;"/>

        <Separator style="-fx-background-color: #292929;"/>

        <HBox alignment="CENTER_LEFT">
            <Label text="TOTAL"
                   style="-fx-text-fill: #BBBBBB; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="labelQuantidade"
                   text="0 itens"
                   style="-fx-text-fill: #888888; -fx-font-size: 12px;"/>
        </HBox>

        <Label fx:id="labelTotal"
               text="R$ 0,00"
               style="-fx-text-fill: #FFD84A; -fx-font-size: 30px; -fx-font-weight: bold;"/>

        <Button text="FINALIZAR PEDIDO"
                onAction="#finalizarPedido"
                maxWidth="Infinity"
                prefHeight="48"
                style="-fx-background-color: #FFD84A; -fx-text-fill: #111111; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 24; -fx-cursor: hand;"/>

        <Button text="LIMPAR PEDIDO"
                onAction="#limparPedido"
                maxWidth="Infinity"
                prefHeight="43"
                style="-fx-background-color: transparent; -fx-border-color: #444444; -fx-border-radius: 22; -fx-background-radius: 22; -fx-border-width: 1.5; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>

    </VBox>

</AnchorPane>



