<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="1080.0"
            prefWidth="1920.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.senai.javafx.brasabrasil.HelloController"
            stylesheets="@style.css">

    <!-- FUNDO PRINCIPAL -->
    <ImageView fitHeight="990.0"
               fitWidth="1920.0"
               layoutY="90.0"
               preserveRatio="false"
               mouseTransparent="true">
        <image>
            <Image url="@imagens/a01683b4-2737-47d4-bc9c-8cb4d7b2472b.png"/>
        </image>
    </ImageView>

    <!-- CAMADA ESCURA PARA VALORIZAR O TEXTO -->
    <AnchorPane layoutY="90.0"
                prefWidth="1920.0"
                prefHeight="990.0"
                mouseTransparent="true"
                style="-fx-background-color: rgba(0,0,0,0.30);"/>



    <!-- CORPO: CHAMADA PRINCIPAL -->
    <VBox alignment="CENTER_LEFT"
          spacing="24.0"
          prefWidth="720.0"
          layoutX="115.0"
          layoutY="275.0"
          mouseTransparent="false">

        <Label text="SABOR • QUALIDADE • TRADIÇÃO"
               style="-fx-text-fill: #FFBE24;
                      -fx-font-family: 'Arial';
                      -fx-font-size: 19px;
                      -fx-font-weight: bold;
                      -fx-letter-spacing: 3px;"/>

        <VBox spacing="0.0">
            <Label text="O VERDADEIRO"
                   style="-fx-text-fill: white;
                          -fx-font-family: 'Arial';
                          -fx-font-size: 48px;
                          -fx-font-weight: bold;"/>

            <Label text="SABOR DA BRASA"
                   style="-fx-text-fill: #FFBE24;
                          -fx-font-family: 'Arial';
                          -fx-font-size: 64px;
                          -fx-font-weight: bold;"/>
        </VBox>

        <Region prefHeight="2.0"
                maxWidth="105.0"
                style="-fx-background-color: #FFBE24;"/>

        <Label text="Hambúrgueres irresistíveis, ingredientes selecionados e aquele sabor que transforma cada mordida em uma grande experiência."
               wrapText="true"
               maxWidth="590.0"
               style="-fx-text-fill: #E0E0E0;
                      -fx-font-family: 'Arial';
                      -fx-font-size: 22px;
                      -fx-line-spacing: 8px;"/>

        <Region prefHeight="8.0"/>

        <Button text="EXPLORAR CARDÁPIO   →"
                onAction="#abrirCardapio"
                prefHeight="58.0"
                prefWidth="300.0"
                style="-fx-background-color: #FFBE24;
                       -fx-text-fill: #111111;
                       -fx-font-family: 'Arial';
                       -fx-font-size: 18px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 5px;
                       -fx-cursor: hand;
                       -fx-padding: 0 20 0 20;"/>

        <Label text="FEITO COM PAIXÃO. SERVIDO COM PERSONALIDADE."
               style="-fx-text-fill: #BDBDBD;
                      -fx-font-family: 'Arial';
                      -fx-font-size: 13px;
                      -fx-font-weight: bold;"/>

    </VBox>

    <fx:include source="Cabecalho.fxml"
                AnchorPane.topAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"/>
</AnchorPane>
